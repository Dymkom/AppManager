<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <object class="AdwDialog" id="shortcuts_window">
        <property name="content-width">500</property>
        <property name="content-height">600</property>
        <property name="child">
            <object class="AdwToolbarView">
                <child type="top">
                    <object class="AdwHeaderBar"/>
                </child>
                <property name="content">
                    <object class="AdwPreferencesPage" id="general_section">
                        <child>
                            <object class="AdwPreferencesGroup" id="navigation_group">
                                <child>
                                    <object class="AdwActionRow" id="shortcut_check_updates">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">&lt;Primary&gt;u</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                                <child>
                                    <object class="AdwActionRow" id="shortcut_update_apps">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">&lt;Primary&gt;&lt;Shift&gt;u</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                                <child>
                                    <object class="AdwActionRow" id="shortcut_main_menu">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">F10</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                                <child>
                                    <object class="AdwActionRow" id="shortcut_search">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">&lt;Primary&gt;f</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                                <child>
                                    <object class="AdwActionRow" id="shortcut_show_overlay">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">&lt;Primary&gt;question</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                            </object>
                        </child>
                        <child>
                            <object class="AdwPreferencesGroup" id="window_group">
                                <child>
                                    <object class="AdwActionRow" id="shortcut_close_window">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">&lt;Primary&gt;w</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                                <child>
                                    <object class="AdwActionRow" id="shortcut_quit">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">&lt;Primary&gt;q</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                                <child>
                                    <object class="AdwActionRow" id="shortcut_fullscreen">
                                        <child type="suffix">
                                            <object class="GtkShortcutLabel">
                                                <property name="accelerator">F11</property>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </property>
            </object>
        </property>
    </object>
</interface>
